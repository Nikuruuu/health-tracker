# Neon Postgres Connection Strings
# Runtime pooled connection (Neon serverless driver)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection for migrations (drizzle-kit)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth
# Secret must be at least 32 characters
BETTER_AUTH_SECRET="replace-with-at-least-32-chars-random-secret-key-12345"
BETTER_AUTH_URL="http://localhost:3000"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"

# Photos Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# USDA Food Data API Key (Optional)
USDA_API_KEY=""

